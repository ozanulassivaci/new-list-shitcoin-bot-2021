# MetaMask wallet credentials used by bot/metamask_wallet.py.
# Copy this file to .env and fill in your own values. Never commit .env.
METAMASK_PASSWORD=your_metamask_password_here
METAMASK_SEED_PHRASE=your_metamask_seed_phrase_here

# Risk profile used by bot/risk_config.py to size each buy. Re-read every
# loop iteration, so you can edit these while the bot is running and it
# picks up the change on the next iteration, no restart needed.
MIN_SPEND_PER_COIN_USD=5
MAX_SPEND_PER_COIN_USD=50
